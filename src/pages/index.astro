---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
import { url } from '../utils/url.js';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import ProductCard from '../components/ProductCard.astro';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const featuredProducts = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---
<Layout title="e-spania — hotele w Barcelonie, Maladze i Madrycie | Rezerwacja" page="start">
  <Fragment slot="head">
    <meta name="description" content="e-spania to hotele w Barcelonie, Maladze i Madrycie: jasne pokoje i spokojny, hiszpański rytm dnia. Wybierz miasto, sprawdź termin i wybierz pokój.">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://kasprzykv00.github.io/strona-astro-e-spania/">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content="e-spania — hotele w Barcelonie, Maladze i Madrycie">
    <meta property="og:description" content="Jasne pokoje i spokojny, hiszpański rytm dnia w trzech miastach. Wybierz hotel, sprawdź dostępność i zaplanuj pobyt.">
    <meta property="og:image" content="https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Basen przed bielonym domem z kwitnącą bugenwillą">

    <link rel="preload" as="image" href={url('assets/images/hero-mobile.webp')} media="(max-width: 767.98px)">
    <link rel="preload" as="image" href={url('assets/images/hero-1280.webp')} imagesrcset={`${url('assets/images/hero-1280.webp')} 1280w, ${url('assets/images/hero-1920.webp')} 1920w`} imagesizes="100vw" media="(min-width: 768px)">

    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania",
          "name": "e-spania",
          "description": "Hotele w Barcelonie, Maladze i Madrycie z jasnymi pokojami i spokojnym, hiszpańskim charakterem.",
          "logo": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/logo/logo-dark.png",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/"
        },
        {
          "@type": "Hotel",
          "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-barcelona",
          "name": "e-spania Barcelona",
          "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
          "address": { "@type": "PostalAddress", "streetAddress": "Passeig de la Llum 12", "postalCode": "08003", "addressLocality": "Barcelona", "addressCountry": "ES" },
          "telephone": "+34 900 000 123",
          "email": "kontakt@e-spania.example",
          "priceRange": "420–980 zł",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
          "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
          "availableLanguage": ["pl", "en", "es"]
        },
        {
          "@type": "Hotel",
          "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-malaga",
          "name": "e-spania Malaga",
          "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
          "address": { "@type": "PostalAddress", "streetAddress": "Paseo del Sol 18", "postalCode": "29016", "addressLocality": "Málaga", "addressCountry": "ES" },
          "telephone": "+34 900 000 123",
          "email": "kontakt@e-spania.example",
          "priceRange": "420–980 zł",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
          "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
          "availableLanguage": ["pl", "en", "es"]
        },
        {
          "@type": "Hotel",
          "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-madryt",
          "name": "e-spania Madryt",
          "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
          "address": { "@type": "PostalAddress", "streetAddress": "Calle de la Luz 21", "postalCode": "28014", "addressLocality": "Madrid", "addressCountry": "ES" },
          "telephone": "+34 900 000 123",
          "email": "kontakt@e-spania.example",
          "priceRange": "420–980 zł",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
          "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
          "availableLanguage": ["pl", "en", "es"]
        },
        {
          "@type": "WebSite",
          "name": "e-spania",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
          "inLanguage": ["pl", "en", "es"],
          "about": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" }
        }
      ]
    }
    </script>
  </Fragment>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero__media">
        <source media="(min-width: 768px)" srcset={`${url('assets/images/hero-1280.webp')} 1280w, ${url('assets/images/hero-1920.webp')} 1920w`} sizes="100vw" width="1920" height="1150">
        <img class="hero__image" src={url('assets/images/hero-mobile.webp')} width="828" height="1300" alt="Basen z turkusową mozaiką przed bielonym domem z kamiennym murem, kwitnącą bugenwillą i palmą" fetchpriority="high">
      </picture>
      <video class="hero__video" id="heroVideo" muted loop playsinline preload="none" aria-hidden="true"
             data-src-landscape={url('assets/video/hero-desktop.mp4')} data-src-portrait={url('assets/video/hero-mobile.mp4')}></video>
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="container hero__inner">
        <div class="hero__content">
          <p class="eyebrow eyebrow--light eyebrow--center hero__eyebrow" data-city="heroEyebrow">e-spania · Barcelona</p>
          <h1 class="hero__title" id="hero-title" data-split data-city="heroTitle">Barcelona, gdzie miasto <em>spotyka morze</em></h1>
          <a class="hero__discover" href="#hotel">
            <span data-city="heroDiscover">Odkryj hotel w Barcelonie</span>
            <span class="hero__discover-icon" aria-hidden="true"><svg class="icon icon--sm"><use href="#i-arrow-down"/></svg></span>
          </a>
        </div>

        <form class="booking" id="rezerwacja" novalidate aria-labelledby="booking-title">
          <h2 class="visually-hidden" id="booking-title">Sprawdź dostępność pobytu</h2>
          <fieldset class="city-switch">
            <legend class="visually-hidden">Wybierz hotel</legend>
            <div class="d-inline-flex align-items-center city-switch__group">
              <svg class="icon icon--sm city-switch__icon" aria-hidden="true"><use href="#i-pin"/></svg>
              <input class="btn-check" type="radio" name="city" id="city-barcelona" value="barcelona" checked>
              <label class="btn city-switch__option" for="city-barcelona">Barcelona</label>
              <input class="btn-check" type="radio" name="city" id="city-malaga" value="malaga">
              <label class="btn city-switch__option" for="city-malaga">Malaga</label>
              <input class="btn-check" type="radio" name="city" id="city-madryt" value="madryt">
              <label class="btn city-switch__option" for="city-madryt">Madryt</label>
            </div>
          </fieldset>
          <p class="visually-hidden" id="cityAnnounce" aria-live="polite"></p>
          <div class="row g-0 booking__bar">
            <div class="col-12 col-lg booking__field booking__field--dates dropup">
              <button class="booking__trigger" type="button" id="datesToggle" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false" aria-describedby="dates-error">
                <span class="visually-hidden">Daty pobytu: </span>
                <span class="booking__value" id="datesSummary">Przyjazd / Wyjazd</span>
                <svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-down"/></svg>
              </button>
              <div class="dropdown-menu booking-pop calendar" id="calendar" role="dialog" aria-label="Kalendarz — wybierz daty pobytu">
                <div class="calendar__head">
                  <button class="icon-btn calendar__nav" type="button" data-cal-step="-1" aria-label="Poprzedni miesiąc"><svg class="icon" aria-hidden="true"><use href="#i-arrow-left"/></svg></button>
                  <p class="calendar__hint" id="calendarHint" aria-live="polite">Wybierz datę przyjazdu</p>
                  <button class="icon-btn calendar__nav" type="button" data-cal-step="1" aria-label="Następny miesiąc"><svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
                </div>
                <div class="calendar__months" id="calendarMonths"></div>
                <div class="booking-pop__foot">
                  <button class="booking-pop__link" type="button" id="calendarClear">Wyczyść</button>
                  <button class="booking-pop__link booking-pop__link--strong" type="button" id="calendarDone">Gotowe</button>
                </div>
              </div>
              <input type="hidden" id="arrival" name="arrival" value="">
              <input type="hidden" id="departure" name="departure" value="">
              <p class="booking__error" id="dates-error" aria-live="polite"></p>
            </div>

            <div class="col-6 col-lg-auto booking__field booking__field--guests dropup">
              <button class="booking__trigger" type="button" id="guestsToggle" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false">
                <span class="visually-hidden">Liczba gości: </span>
                <span class="booking__value" id="guestsSummary">2 dorosłych</span>
                <svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-down"/></svg>
              </button>
              <div class="dropdown-menu booking-pop guests">
                <div class="guests__row">
                  <label class="guests__label" for="adults">Dorośli <small>od 13 lat</small></label>
                  <div class="stepper">
                    <button class="icon-btn stepper__btn" type="button" data-step="-1" data-target="adults" aria-label="Mniej dorosłych"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-minus"/></svg></button>
                    <input class="stepper__input" type="number" id="adults" name="adults" value="2" min="1" max="6" inputmode="numeric">
                    <button class="icon-btn stepper__btn" type="button" data-step="1" data-target="adults" aria-label="Więcej dorosłych"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-plus"/></svg></button>
                  </div>
                </div>
                <div class="guests__row">
                  <label class="guests__label" for="children">Dzieci <small>0–12 lat</small></label>
                  <div class="stepper">
                    <button class="icon-btn stepper__btn" type="button" data-step="-1" data-target="children" aria-label="Mniej dzieci"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-minus"/></svg></button>
                    <input class="stepper__input" type="number" id="children" name="children" value="0" min="0" max="4" inputmode="numeric">
                    <button class="icon-btn stepper__btn" type="button" data-step="1" data-target="children" aria-label="Więcej dzieci"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-plus"/></svg></button>
                  </div>
                </div>
                <div class="booking-pop__foot booking-pop__foot--end">
                  <button class="booking-pop__link booking-pop__link--strong guests__done" type="button">Gotowe</button>
                </div>
              </div>
            </div>

            <div class="col-6 col-lg-auto booking__field">
              <button class="booking__trigger" type="button" id="roomTrigger" data-bs-toggle="offcanvas" data-bs-target="#roomPanel" aria-controls="roomPanel" aria-describedby="room-error">
                <span class="visually-hidden">Pokój: </span>
                <span class="booking__value" id="roomSummary">Dowolny pokój</span>
                <svg class="icon icon--sm" aria-hidden="true"><use href="#i-chevron-right"/></svg>
              </button>
              <input type="hidden" name="room" id="roomInput" value="">
              <p class="booking__error" id="room-error" aria-live="polite"></p>
            </div>

            <div class="col-12 col-lg-auto booking__submit">
              <button class="btn btn-accent booking__button" type="submit">Sprawdź dostępność</button>
            </div>
          </div>
          <p class="booking__status" id="bookingStatus" aria-live="polite">Wybierz daty i pokój, a resztę dokończysz w kolejnym kroku.</p>
        </form>
      </div>

      <button class="icon-btn hero__video-toggle" type="button" id="heroVideoToggle" aria-pressed="false" aria-label="Wstrzymaj film w tle" hidden>
        <svg class="icon icon--sm hero__icon-pause" aria-hidden="true"><use href="#i-pause"/></svg>
        <svg class="icon icon--sm hero__icon-play" aria-hidden="true"><use href="#i-play"/></svg>
      </button>
    </section>

    <section class="section about" id="hotel" aria-labelledby="about-title">
      <div class="container">
        <div class="row gy-5 align-items-center">
          <div class="col-lg-5 order-lg-2 offset-xl-1">
            <p class="eyebrow" data-reveal>01 — Hotel</p>
            <h2 class="section-title" id="about-title" data-reveal data-split data-city="aboutTitle">Barcelona <em>we własnym tempie</em></h2>
            <p class="lead-text" data-reveal data-city="aboutLead">Barcelona łączy miejskie plaże, modernistyczne kamienice i wąskie uliczki Dzielnicy Gotyckiej. Po dniu pełnym wrażeń warto mieć miejsce, w którym czas płynie wolniej.</p>
            <p data-reveal data-city="aboutText">e-spania Barcelona to propozycja pobytu w katalońskim rytmie — jasne wnętrza, naturalne materiały i spokojne poranki przed wyjściem do miasta.</p>
            <ul class="principles" data-reveal data-city="principles">
              <li class="principles__item"><span class="principles__name">Światło</span><span class="principles__text">jasne wnętrza i naturalne materiały</span></li>
              <li class="principles__item"><span class="principles__name">Morze</span><span class="principles__text">miejskie plaże i nadmorskie promenady</span></li>
              <li class="principles__item"><span class="principles__name">Modernizm</span><span class="principles__text">architektura Gaudiego i gotyckie zaułki</span></li>
            </ul>
          </div>
          <div class="col-lg-7 col-xl-6 order-lg-1">
            <div class="about__media">
              <figure class="about__figure about__figure--main media-frame" data-reveal="clip" data-parallax="0.05">
                <img src={url('assets/images/about-house.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Bielona fasada z drewnianymi okiennicami i palmą na tle błękitnego nieba">
              </figure>
              <figure class="about__figure about__figure--accent media-frame" data-reveal="clip" data-parallax="-0.08">
                <img src={url('assets/images/about-courtyard.webp')} width="800" height="1000" loading="lazy" decoding="async" alt="Patio z drzewkami cytrynowymi w terakotowych donicach">
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section rooms" id="pokoje" aria-labelledby="rooms-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow" data-reveal>02 — Pokoje</p>
            <h2 class="section-title" id="rooms-title" data-reveal data-split>Cztery sposoby na <em>dobry sen</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal>Od kameralnego pokoju po suitę z balkonem — te same cztery kategorie w każdym z trzech hoteli. Kliknij „Wybierz”, aby zobaczyć pokój w panelu i dodać go do wyszukiwania.</p>
          </div>
        </div>

        <div class="row gx-lg-5">
          <div class="col-md-6 col-lg-7">
            <article class="room-card" data-room-id="classic" data-room-capacity="2" data-reveal>
              <figure class="room-card__media media-frame" data-reveal="clip">
                <img src={url('assets/images/room-classic.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Jasny pokój z podwójnym łóżkiem, białą pościelą i dekoracyjnymi kapeluszami na ścianie">
              </figure>
              <div class="room-card__body">
                <span class="room-card__index" aria-hidden="true">01</span>
                <h3 class="room-card__title">Pokój Classic</h3>
                <p class="room-card__text">Jasne wnętrze z naturalnymi tkaninami i rękodziełem. Proste, wygodne i pełne światła.</p>
                <ul class="room-meta">
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-users"/></svg>do 2 gości</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-area"/></svg>ok. 22 m²</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-bed"/></svg>łóżko podwójne</li>
                  <li class="room-meta__price">420 zł / noc</li>
                </ul>
                <button class="btn link-arrow" type="button" data-open-room="classic">Wybierz <span class="visually-hidden">pokój Classic</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></button>
              </div>
            </article>
          </div>
          <div class="col-md-6 col-lg-5 rooms__offset">
            <article class="room-card" data-room-id="deluxe" data-room-capacity="2" data-reveal>
              <figure class="room-card__media room-card__media--tall media-frame" data-reveal="clip">
                <img src={url('assets/images/room-deluxe.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Przestronny pokój z lnianą pościelą, rzeźbionym panelem nad łóżkiem i jutowym dywanem">
              </figure>
              <div class="room-card__body">
                <span class="room-card__index" aria-hidden="true">02</span>
                <h3 class="room-card__title">Pokój Deluxe</h3>
                <p class="room-card__text">Więcej przestrzeni, rzeźbione detale i len w odcieniach piasku. Na dłuższy, niespieszny pobyt.</p>
                <ul class="room-meta">
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-users"/></svg>do 2 gości</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-area"/></svg>ok. 30 m²</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-bed"/></svg>łóżko king-size</li>
                  <li class="room-meta__price">560 zł / noc</li>
                </ul>
                <button class="btn link-arrow" type="button" data-open-room="deluxe">Wybierz <span class="visually-hidden">pokój Deluxe</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></button>
              </div>
            </article>
          </div>
          <div class="col-md-6 col-lg-5">
            <article class="room-card" data-room-id="junior" data-room-capacity="3" data-reveal>
              <figure class="room-card__media room-card__media--tall media-frame" data-reveal="clip">
                <img src={url('assets/images/room-junior.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Sypialnia z łukowymi oknami wychodzącymi na zieleń i kutym żyrandolem">
              </figure>
              <div class="room-card__body">
                <span class="room-card__index" aria-hidden="true">03</span>
                <h3 class="room-card__title">Junior Suite</h3>
                <p class="room-card__text">Łukowe okna, grube ściany i strefa wypoczynku na leniwe popołudnia z książką.</p>
                <ul class="room-meta">
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-users"/></svg>do 3 gości</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-area"/></svg>ok. 38 m²</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-bed"/></svg>king-size + sofa</li>
                  <li class="room-meta__price">720 zł / noc</li>
                </ul>
                <button class="btn link-arrow" type="button" data-open-room="junior">Wybierz <span class="visually-hidden">Junior Suite</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></button>
              </div>
            </article>
          </div>
          <div class="col-md-6 col-lg-7 rooms__offset">
            <article class="room-card" data-room-id="suite" data-room-capacity="4" data-reveal>
              <figure class="room-card__media media-frame" data-reveal="clip">
                <img src={url('assets/images/room-suite.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Otwarte drzwi balkonowe z widokiem na morze o zmierzchu">
              </figure>
              <div class="room-card__body">
                <span class="room-card__index" aria-hidden="true">04</span>
                <h3 class="room-card__title">Suite z balkonem</h3>
                <p class="room-card__text">Prywatny balkon, najwięcej przestrzeni i wieczory, które kończą się dopiero po zachodzie słońca.</p>
                <ul class="room-meta">
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-users"/></svg>do 4 gości</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-area"/></svg>ok. 48 m²</li>
                  <li><svg class="icon icon--sm" aria-hidden="true"><use href="#i-view"/></svg>balkon</li>
                  <li class="room-meta__price">980 zł / noc</li>
                </ul>
                <button class="btn link-arrow" type="button" data-open-room="suite">Wybierz <span class="visually-hidden">Suite z balkonem</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></button>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--dark experiences" id="doswiadczenia" aria-labelledby="experiences-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow eyebrow--light" data-reveal>03 — Doświadczenia</p>
            <h2 class="section-title" id="experiences-title" data-reveal data-split>Dni, które <em>same się układają</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal data-city="experiencesIntro">Jeden dzień w Barcelonie — od poranka do późnego wieczoru. Wycieczki z przewodnikiem dodasz do pobytu przy rezerwacji.</p>
          </div>
        </div>

        <div class="row gy-5 gx-lg-5" data-city="experiences">
          <div class="col-md-4">
            <article class="experience" data-reveal>
              <figure class="experience__media media-frame" data-reveal="clip">
                <img src={url('assets/images/cities/barcelona-guell.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Wieża z mozaiki i pawilon projektu Gaudiego w Parku Güell, w tle panorama Barcelony">
              </figure>
              <p class="experience__time">Poranek</p>
              <h3 class="experience__title">Park Güell</h3>
              <p class="experience__text">Mozaiki Gaudiego i widok na całe miasto — najlepiej rano, zanim zrobi się gorąco.</p>
            </article>
          </div>
          <div class="col-md-4 experiences__offset">
            <article class="experience" data-reveal>
              <figure class="experience__media media-frame" data-reveal="clip">
                <img src={url('assets/images/cities/barcelona-beach.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Rdzawa rzeźba z ułożonych sześcianów na plaży Barceloneta, plażowicze i morze">
              </figure>
              <p class="experience__time">Popołudnie</p>
              <h3 class="experience__title">Plaża Barceloneta</h3>
              <p class="experience__text">Nadmorska promenada, piasek pod stopami i chwila odpoczynku po zwiedzaniu.</p>
            </article>
          </div>
          <div class="col-md-4">
            <article class="experience" data-reveal>
              <figure class="experience__media media-frame" data-reveal="clip">
                <img src={url('assets/images/cities/barcelona-gothic.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Wąska, mokra od deszczu uliczka Dzielnicy Gotyckiej prowadząca do oświetlonej wieży katedry">
              </figure>
              <p class="experience__time">Wieczór</p>
              <h3 class="experience__title">Dzielnica Gotycka</h3>
              <p class="experience__text">Wąskie uliczki wokół katedry i tapas w jednym z barów po drodze.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="section gallery" id="galeria" aria-labelledby="gallery-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow" data-reveal>04 — Galeria</p>
            <h2 class="section-title" id="gallery-title" data-reveal data-split>Hiszpania <em>w detalach</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal>Światło, materiały i detale, które towarzyszą pobytowi w naszych hotelach.</p>
          </div>
        </div>

        <ul class="gallery__grid">
          <li class="gallery__item" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-pool-arches.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Wąski basen z turkusowymi płytkami prowadzący do mauretańskich łuków"></button></li>
          <li class="gallery__item gallery__item--wide" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-courtyard-pool.webp')} width="1200" height="800" loading="lazy" decoding="async" alt="Zacieniony dziedziniec z basenem, roślinami w donicach i arkadami"></button></li>
          <li class="gallery__item" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-tiles.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Ściana z kolorowymi płytkami azulejos otoczona zielenią"></button></li>
          <li class="gallery__item" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-olive.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Drzewo oliwne w donicy przy kamiennym łuku"></button></li>
          <li class="gallery__item" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-lane.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Bielony zaułek z brukiem w okrągłe wzory i roślinami w donicach"></button></li>
          <li class="gallery__item gallery__item--wide" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-white-house.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Bielony dom z szarymi drzwiami, kamiennymi schodami i śródziemnomorskim ogrodem"></button></li>
          <li class="gallery__item gallery__item--wide" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-terrace.webp')} width="1200" height="800" loading="lazy" decoding="async" alt="Taras z mozaikowym stolikiem i widokiem na morze o zmierzchu"></button></li>
          <li class="gallery__item" data-reveal="clip"><button class="gallery__button media-frame" type="button"><img src={url('assets/images/gal-patio.webp')} width="900" height="1200" loading="lazy" decoding="async" alt="Słoneczne patio z łukowym przejściem, palmami i czerwonymi kwiatami"></button></li>
        </ul>
      </div>
    </section>

    <section class="section section--soft" id="opinie" aria-labelledby="reviews-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow" data-reveal>05 — Opinie</p>
            <h2 class="section-title" id="reviews-title" data-reveal data-split>Głosy <em>gości</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal>Kilka słów od osób, które zatrzymały się w naszych hotelach.</p>
          </div>
        </div>

        <div class="row gy-4 gx-lg-5">
          <div class="col-md-4">
            <figure class="review" data-reveal>
              <p class="review__stars"><span class="product-rating__stars" aria-hidden="true"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span><span class="visually-hidden">Ocena 5 na 5</span></p>
              <blockquote class="review__quote"><p>„Rano kawa na patio, wieczorem spacer nad morze. Po trzech dniach przestałam sprawdzać godzinę. Obsługa pamiętała, że lubię stolik w cieniu.”</p></blockquote>
              <figcaption class="review__source">
                <span class="review__platform">Marta K.</span>
                <span class="review__stay">Barcelona, wrzesień 2026</span>
              </figcaption>
            </figure>
          </div>
          <div class="col-md-4">
            <figure class="review" data-reveal>
              <p class="review__stars"><span class="product-rating__stars" aria-hidden="true"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i></span><span class="visually-hidden">Ocena 4,5 na 5</span></p>
              <blockquote class="review__quote"><p>„Wybraliśmy Juniora Suite i wycieczkę do Granady, którą hotel zorganizował od początku do końca. Pokój jest cichy, a śniadania przypominają domowy stół.”</p></blockquote>
              <figcaption class="review__source">
                <span class="review__platform">Tomasz i Ewa</span>
                <span class="review__stay">Malaga, październik 2026</span>
              </figcaption>
            </figure>
          </div>
          <div class="col-md-4">
            <figure class="review" data-reveal>
              <p class="review__stars"><span class="product-rating__stars" aria-hidden="true"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i></span><span class="visually-hidden">Ocena 5 na 5</span></p>
              <blockquote class="review__quote"><p>„Idealna baza do zwiedzania Madrytu. Po całym dniu w muzeach miło było wrócić do jasnego, spokojnego pokoju. Na pewno tu wrócimy.”</p></blockquote>
              <figcaption class="review__source">
                <span class="review__platform">Karolina S.</span>
                <span class="review__stay">Madryt, sierpień 2026</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="section blog-teaser" id="blog" aria-labelledby="blog-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow" data-reveal>06 — Blog</p>
            <h2 class="section-title" id="blog-title" data-reveal data-split>Przed podróżą do <em>Hiszpanii</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal>Praktyczne porady dla osób, które planują wyjazd: kiedy jechać, co zjeść, co zwiedzić i jak odnaleźć się w hiszpańskim rytmie dnia.</p>
          </div>
        </div>

        <div class="row gy-5 gx-lg-5">
          {latestPosts.map((post) => (
            <div class="col-md-4"><PostCard post={post} /></div>
          ))}
        </div>

        <div class="d-flex justify-content-center blog-teaser__more" data-reveal>
          <a class="btn btn-ink btn-lg-pill" href={url('blog/')}>Wszystkie wpisy na blogu</a>
        </div>
      </div>
    </section>

    <section class="section section--soft shop-teaser" id="sklep" aria-labelledby="shop-title">
      <div class="container">
        <div class="row align-items-end gy-4 section-head">
          <div class="col-lg-7">
            <p class="eyebrow" data-reveal>07 — Sklep</p>
            <h2 class="section-title" id="shop-title" data-reveal data-split>Hiszpania, którą <em>zabierzesz do domu</em></h2>
          </div>
          <div class="col-lg-5">
            <p class="mb-0" data-reveal>Rzeczy, które znasz z naszych hoteli: ręczniki na plażę, ceramika ze stołu śniadaniowego, zapach kwiatu pomarańczy. I voucher dla kogoś, kto powinien tu przyjechać.</p>
          </div>
        </div>

        <div class="row gy-5 gx-3 gx-lg-4">
          {featuredProducts.map((product) => (
            <div class="col-6 col-lg-3"><ProductCard product={product} reveal /></div>
          ))}
        </div>

        <div class="d-flex justify-content-center shop-teaser__more" data-reveal>
          <a class="btn btn-ink btn-lg-pill" href={url('sklep/')}>Wszystkie produkty</a>
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <img class="cta__image" data-parallax="0.1" data-city="ctaImage" src={url('assets/images/cta-bay.webp')} width="1920" height="1000" loading="lazy" decoding="async" alt="Zatoka z łodziami żaglowymi o zachodzie słońca">
      <div class="cta__shade" aria-hidden="true"></div>
      <div class="container cta__inner">
        <p class="eyebrow eyebrow--light eyebrow--center" data-reveal>Twój pobyt</p>
        <h2 class="cta__title" id="cta-title" data-reveal data-split>Zostań, aż zajdzie <em>słońce</em></h2>
        <p class="cta__text" data-reveal data-city="ctaText">Wybierz daty i pokój — pokażemy, jak mógłby wyglądać Twój pobyt w Barcelonie.</p>
        <div data-reveal>
          <a class="btn btn-accent btn-lg-pill" href="#rezerwacja" data-action="focus-booking">Sprawdź dostępność</a>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="po-stopce">
    <div class="offcanvas offcanvas-end room-panel" tabindex="-1" id="roomPanel" aria-labelledby="roomPanelTitle">
      <div class="offcanvas-header room-panel__header">
        <div>
          <p class="eyebrow mb-1" data-city="roomPanelEyebrow">Wybór pokoju · Barcelona</p>
          <h2 class="room-panel__title" id="roomPanelTitle">Pokoje i suity</h2>
          <p class="room-panel__summary" id="roomPanelSummary" aria-live="polite">Wybierz pokój, a dodamy go do wyszukiwania.</p>
        </div>
        <button type="button" class="btn text-btn room-panel__close" data-bs-dismiss="offcanvas">
          <svg class="icon" aria-hidden="true"><use href="#i-close"/></svg>
          <span>Zamknij</span>
        </button>
      </div>
      <div class="offcanvas-body room-panel__body">
        <div class="row g-0 h-100">
          <div class="col-lg-5 room-panel__list-col">
            <ul class="room-list" id="roomList"></ul>
            <p class="side-note room-panel__note">Cena za pokój za noc. Dodatki i wycieczki wybierzesz w następnym kroku.</p>
          </div>
          <div class="col-lg-7 d-none d-lg-block room-panel__preview-col">
            <figure class="room-preview">
              <img class="room-preview__image" id="roomPreviewImage" src={url('assets/images/room-classic.webp')} width="1200" height="900" loading="lazy" alt="Jasny pokój z podwójnym łóżkiem, białą pościelą i dekoracyjnymi kapeluszami na ścianie">
              <figcaption class="room-preview__caption">
                <span class="room-preview__name" id="roomPreviewName">Pokój Classic</span>
                <span class="room-preview__text" id="roomPreviewText"></span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade lightbox" id="galleryModal" tabindex="-1" aria-labelledby="lightboxCaption">
      <div class="modal-dialog modal-fullscreen">
        <div class="modal-content lightbox__content">
          <button type="button" class="btn text-btn lightbox__close" data-bs-dismiss="modal">
            <svg class="icon" aria-hidden="true"><use href="#i-close"/></svg><span>Zamknij</span>
          </button>
          <figure class="lightbox__figure">
            <img class="lightbox__image" id="lightboxImage" src={url('assets/images/gal-pool-arches.webp')} loading="lazy" alt="Wąski basen z turkusowymi płytkami prowadzący do mauretańskich łuków">
            <figcaption class="lightbox__caption" id="lightboxCaption" aria-live="polite"></figcaption>
          </figure>
          <button type="button" class="icon-btn lightbox__nav lightbox__nav--prev" data-gallery-step="-1" aria-label="Poprzednie zdjęcie"><svg class="icon" aria-hidden="true"><use href="#i-chevron-left"/></svg></button>
          <button type="button" class="icon-btn lightbox__nav lightbox__nav--next" data-gallery-step="1" aria-label="Następne zdjęcie"><svg class="icon" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
        </div>
      </div>
    </div>

    <Toast />
  </Fragment>
</Layout>
