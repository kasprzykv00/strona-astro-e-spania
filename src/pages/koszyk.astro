---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
import { url } from '../utils/url.js';
---
<Layout title="Koszyk | Sklep e-spania" page="koszyk">
  <Fragment slot="head">
    <meta name="description" content="Twój koszyk w sklepie e-spania: sprawdź produkty, zmień ilość, wpisz kod rabatowy i przejdź do kasy.">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content="Koszyk — sklep e-spania">
    <meta property="og:description" content="Twój koszyk w sklepie e-spania: sprawdź produkty, zmień ilość, wpisz kod rabatowy i przejdź do kasy.">
    <meta property="og:url" content="https://kasprzykv00.github.io/strona-astro-e-spania/koszyk/">
    <meta property="og:image" content="https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/sklep/og-sklep.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Złożone ręczniki w piaskowe i granatowe pasy">

    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "Koszyk",
          "description": "Twój koszyk w sklepie e-spania: sprawdź produkty, zmień ilość, wpisz kod rabatowy i przejdź do kasy.",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/koszyk/",
          "inLanguage": "pl"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Strona główna",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Sklep",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/sklep/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Koszyk",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/koszyk/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <section class="page-header page-header--plain" aria-labelledby="page-title">
    <div class="container page-header__inner">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb blog-breadcrumb">
          <li class="breadcrumb-item"><a href={url()}>Strona główna</a></li>
          <li class="breadcrumb-item"><a href={url('sklep/')}>Sklep</a></li>
          <li class="breadcrumb-item active" aria-current="page">Koszyk</li>
        </ol>
      </nav>
      <h1 class="page-header__title" id="page-title">Twój <em>koszyk</em></h1>
    </div>
  </section>

  <main id="main" class="container shop-layout">
    <div class="row gx-lg-5 gy-5">
      <div class="col-lg-8">
        <h2 class="visually-hidden">Produkty w koszyku</h2>
        <div class="table-responsive" id="cartTableWrap">
          <table class="table cart-table">
            <caption class="visually-hidden">Produkty w koszyku</caption>
            <thead>
              <tr>
                <th scope="col">Produkt</th>
                <th scope="col">Cena jednostkowa</th>
                <th scope="col">Ilość</th>
                <th scope="col">Wartość łączna</th>
                <th scope="col"><span class="visually-hidden">Akcja</span></th>
              </tr>
            </thead>
            <tbody id="cartBody">
              <tr>
                <td class="cart-table__product" data-label="Produkt"><a class="cart-item" href={url('sklep/costa/')}><img class="cart-item__thumb" src={url('assets/images/sklep/recznik-costa-800.webp')} width="800" height="800" alt="Złożony niebieski ręcznik w białe paski, zakończony frędzlami"><span><span class="cart-item__name">Ręcznik plażowy Costa</span><span class="cart-item__variant">Niebieski</span></span></a></td>
                <td data-label="Cena jednostkowa">149 zł</td>
                <td data-label="Ilość"><label class="visually-hidden" for="qty-0">Ilość: Ręcznik plażowy Costa</label><input class="form-control cart-qty" type="number" id="qty-0" min="1" max="10" value="1" inputmode="numeric"></td>
                <td class="cart-table__total" data-label="Wartość łączna">149 zł</td>
                <td class="cart-table__action" data-label="Akcja"><button class="icon-btn cart-remove" type="button" aria-label="Usuń z koszyka: Ręcznik plażowy Costa"><i class="bi bi-trash" aria-hidden="true"></i></button></td>
              </tr>
              <tr>
                <td class="cart-table__product" data-label="Produkt"><a class="cart-item" href={url('sklep/alba/')}><img class="cart-item__thumb" src={url('assets/images/sklep/ceramika-alba-800.webp')} width="800" height="800" alt="Biała ceramika z drobnymi kropkami: talerz, kubek i miseczka"><span><span class="cart-item__name">Komplet ceramiki Alba</span><span class="cart-item__variant">Na 1 osobę</span></span></a></td>
                <td data-label="Cena jednostkowa">289 zł</td>
                <td data-label="Ilość"><label class="visually-hidden" for="qty-1">Ilość: Komplet ceramiki Alba</label><input class="form-control cart-qty" type="number" id="qty-1" min="1" max="10" value="1" inputmode="numeric"></td>
                <td class="cart-table__total" data-label="Wartość łączna">289 zł</td>
                <td class="cart-table__action" data-label="Akcja"><button class="icon-btn cart-remove" type="button" aria-label="Usuń z koszyka: Komplet ceramiki Alba"><i class="bi bi-trash" aria-hidden="true"></i></button></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="shop-empty" id="cartEmpty" hidden>
          <p>Twój koszyk jest pusty.</p>
          <a class="btn btn-ink" id="cartEmptyLink" href={url('sklep/')}>Przejdź do sklepu</a>
        </div>

        <form class="discount-form shop-form" id="discountForm" novalidate>
          <label class="form-label" for="discountCode">Kod rabatowy</label>
          <div class="discount-form__row">
            <input class="form-control" type="text" id="discountCode" autocomplete="off" aria-describedby="discountHint discountMessage">
            <button class="btn btn-outline-ink" type="submit">Aktywuj</button>
          </div>
          <p class="discount-form__hint" id="discountHint">Pierwsze zakupy? Kod HOLA10 daje 10% rabatu.</p>
          <p class="discount-form__message" id="discountMessage" role="status"></p>
        </form>
      </div>

      <div class="col-lg-4">
        <section class="card summary-card" aria-labelledby="summary-title">
          <div class="card-body">
            <h2 class="summary-card__title" id="summary-title">Podsumowanie</h2>
            <ul class="summary-list">
              <li class="summary-item"><span>Suma częściowa</span><span id="sumSubtotal">438 zł</span></li>
              <li class="summary-item summary-item--discount" id="sumDiscountRow" hidden><span>Rabat</span><span id="sumDiscount"></span></li>
              <li class="summary-item"><span>Szacowany koszt dostawy</span><span id="sumShipping">14,90 zł</span></li>
            </ul>
            <p class="summary-total"><span>Razem brutto</span><strong id="sumTotal">452,90 zł</strong></p>
            <a class="btn btn-accent btn-lg-pill w-100" id="goToCheckout" href={url('zamowienie/')}>Przejdź do kasy</a>
            <a class="summary-card__back" href={url('sklep/')}>Wróć do sklepu</a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Toast slot="po-stopce" />
</Layout>
