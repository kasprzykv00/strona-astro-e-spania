---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url.js';
---
<Layout title="Rezerwacja pobytu — pokój, dodatki i wycieczki | e-spania" page="rezerwacja">
  <Fragment slot="head">
    <meta name="description" content="Zarezerwuj pobyt w e-spania: wybierz hotel w Barcelonie, Maladze lub Madrycie, pokój, dodatki i wycieczki, a cenę zobaczysz od razu.">

    <!-- Open Graph: pełne adresy strony na GitHub Pages (https://kasprzykv00.github.io/strona-astro-e-spania/). -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content="Rezerwacja pobytu w e-spania">
    <meta property="og:description" content="Zarezerwuj pobyt w e-spania: wybierz hotel w Barcelonie, Maladze lub Madrycie, pokój, dodatki i wycieczki, a cenę zobaczysz od razu.">
    <meta property="og:url" content="https://kasprzykv00.github.io/strona-astro-e-spania/rezerwacja/">
    <meta property="og:image" content="https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Basen przed bielonym domem z kwitnącą bugenwillą">

    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "Rezerwacja pobytu",
          "description": "Zarezerwuj pobyt w e-spania: wybierz hotel w Barcelonie, Maladze lub Madrycie, pokój, dodatki i wycieczki, a cenę zobaczysz od razu.",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/rezerwacja/",
          "inLanguage": "pl"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Strona główna",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Rezerwacja",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/rezerwacja/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <section class="page-header page-header--plain" aria-labelledby="page-title">
    <div class="container page-header__inner">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb blog-breadcrumb">
          <li class="breadcrumb-item"><a href={url()}>Strona główna</a></li>
          <li class="breadcrumb-item active" aria-current="page">Rezerwacja</li>
        </ol>
      </nav>
      <h1 class="page-header__title" id="page-title">Zaplanuj <em>swój pobyt</em></h1>
      <p class="page-header__text">Wybierz pokój, dodaj to, co lubisz, i zobacz cenę od razu. Rezerwację znajdziesz potem na swoim koncie.</p>
    </div>
  </section>

  <main id="main" class="container shop-layout">
    <form class="shop-form" id="reservationForm" novalidate>
      <div class="row gx-lg-5 gy-5">
        <div class="col-lg-8">
          <div class="form-errors" id="reservationErrors" role="alert" tabindex="-1" hidden>
            <h2 class="form-errors__title">Sprawdź formularz</h2>
            <ul></ul>
          </div>

          <section class="form-section" aria-labelledby="res-stay">
            <h2 class="form-section__title" id="res-stay"><span class="form-section__step">1</span> Termin i goście</h2>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="resCity">Hotel</label>
                <select class="form-select" id="resCity"><option value="barcelona">e-spania Barcelona</option><option value="malaga">e-spania Malaga</option><option value="madryt">e-spania Madryt</option></select>
              </div>
              <div class="col-6">
                <label class="form-label" for="resArrival">Przyjazd</label>
                <input class="form-control" type="date" id="resArrival" required>
                <div class="invalid-feedback">Wybierz datę przyjazdu.</div>
              </div>
              <div class="col-6">
                <label class="form-label" for="resDeparture">Wyjazd</label>
                <input class="form-control" type="date" id="resDeparture" required>
                <div class="invalid-feedback" id="resDepartureFeedback" data-feedback="resDeparture">Wybierz datę wyjazdu.</div>
              </div>
              <div class="col-6">
                <label class="form-label" for="resAdults">Dorośli</label>
                <input class="form-control" type="number" id="resAdults" value="2" min="1" max="6" inputmode="numeric" required>
                <div class="invalid-feedback" data-feedback="resAdults">Pokoje mieszczą maksymalnie 4 gości.</div>
              </div>
              <div class="col-6">
                <label class="form-label" for="resChildren">Dzieci (0–12 lat)</label>
                <input class="form-control" type="number" id="resChildren" value="0" min="0" max="4" inputmode="numeric">
              </div>
            </div>
          </section>

          <section class="form-section">
            <fieldset>
              <legend class="form-section__title"><span class="form-section__step">2</span> Pokój</legend>
              <div class="row g-3">
            <div class="col-12">
              <div class="option-card option-card--room">
                <img class="option-card__image" src={url('assets/images/room-classic.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Jasny pokój z podwójnym łóżkiem i białą pościelą">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="room" id="room-classic" value="classic" checked>
                  <label class="form-check-label" for="room-classic">
                    <span class="option-card__name">Pokój Classic</span>
                    <span class="option-card__text">Jasne wnętrze z naturalnymi tkaninami i rękodziełem. Do 2 gości, ok. 22 m², łóżko podwójne.</span>
                    <span class="option-card__limit" id="room-classic-limit"></span>
                  </label>
                </div>
                <span class="option-card__price">420 zł<small>noc</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card option-card--room">
                <img class="option-card__image" src={url('assets/images/room-deluxe.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Przestronny pokój z lnianą pościelą i rzeźbionym panelem nad łóżkiem">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="room" id="room-deluxe" value="deluxe">
                  <label class="form-check-label" for="room-deluxe">
                    <span class="option-card__name">Pokój Deluxe</span>
                    <span class="option-card__text">Więcej przestrzeni, rzeźbione detale i len w odcieniach piasku. Do 2 gości, ok. 30 m², łóżko king-size.</span>
                    <span class="option-card__limit" id="room-deluxe-limit"></span>
                  </label>
                </div>
                <span class="option-card__price">560 zł<small>noc</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card option-card--room">
                <img class="option-card__image" src={url('assets/images/room-junior.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Sypialnia z łukowymi oknami wychodzącymi na zieleń">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="room" id="room-junior" value="junior">
                  <label class="form-check-label" for="room-junior">
                    <span class="option-card__name">Junior Suite</span>
                    <span class="option-card__text">Łukowe okna, grube ściany i strefa wypoczynku. Do 3 gości, ok. 38 m², king-size + sofa.</span>
                    <span class="option-card__limit" id="room-junior-limit"></span>
                  </label>
                </div>
                <span class="option-card__price">720 zł<small>noc</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card option-card--room">
                <img class="option-card__image" src={url('assets/images/room-suite.webp')} width="1200" height="900" loading="lazy" decoding="async" alt="Otwarte drzwi balkonowe z widokiem na morze o zmierzchu">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="room" id="room-suite" value="suite">
                  <label class="form-check-label" for="room-suite">
                    <span class="option-card__name">Suite z balkonem</span>
                    <span class="option-card__text">Prywatny balkon i najwięcej przestrzeni. Do 4 gości, ok. 48 m², balkon.</span>
                    <span class="option-card__limit" id="room-suite-limit"></span>
                  </label>
                </div>
                <span class="option-card__price">980 zł<small>noc</small></span>
              </div>
            </div>
              </div>
            </fieldset>
          </section>

          <section class="form-section">
            <fieldset>
              <legend class="form-section__title"><span class="form-section__step">3</span> Dodatki do pobytu</legend>
              <div class="row g-3">
            <div class="col-12">
              <div class="option-card">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="checkbox" data-group="extra" id="extra-breakfast" value="breakfast">
                  <label class="form-check-label" for="extra-breakfast">
                    <span class="option-card__name"><i class="bi bi-cup-hot" aria-hidden="true"></i> Śniadanie w patio</span>
                    <span class="option-card__text">Świeże pieczywo, owoce, oliwa i kawa podawane do 11:00.</span>
                  </label>
                </div>
                <span class="option-card__price">59 zł<small>os. / noc</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="checkbox" data-group="extra" id="extra-transfer" value="transfer">
                  <label class="form-check-label" for="extra-transfer">
                    <span class="option-card__name"><i class="bi bi-car-front" aria-hidden="true"></i> Transfer z lotniska</span>
                    <span class="option-card__text">Kierowca czeka w hali przylotów z tabliczką.</span>
                  </label>
                </div>
                <span class="option-card__price">180 zł<small>za przejazd</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="checkbox" data-group="extra" id="extra-late" value="late">
                  <label class="form-check-label" for="extra-late">
                    <span class="option-card__name"><i class="bi bi-clock" aria-hidden="true"></i> Późne wymeldowanie</span>
                    <span class="option-card__text">Pokój zostaje Twój do 16:00 w dniu wyjazdu.</span>
                  </label>
                </div>
                <span class="option-card__price">90 zł<small>jednorazowo</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="checkbox" data-group="extra" id="extra-parking" value="parking">
                  <label class="form-check-label" for="extra-parking">
                    <span class="option-card__name"><i class="bi bi-p-square" aria-hidden="true"></i> Miejsce parkingowe</span>
                    <span class="option-card__text">Strzeżony parking w garażu hotelu.</span>
                  </label>
                </div>
                <span class="option-card__price">70 zł<small>za noc</small></span>
              </div>
            </div>
            <div class="col-12">
              <div class="option-card">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="checkbox" data-group="extra" id="extra-cava" value="cava">
                  <label class="form-check-label" for="extra-cava">
                    <span class="option-card__name"><i class="bi bi-gift" aria-hidden="true"></i> Cava i owoce w pokoju</span>
                    <span class="option-card__text">Czekają schłodzone na Twój przyjazd.</span>
                  </label>
                </div>
                <span class="option-card__price">120 zł<small>jednorazowo</small></span>
              </div>
            </div>
              </div>
            </fieldset>
          </section>

          <section class="form-section">
            <fieldset>
              <legend class="form-section__title"><span class="form-section__step">4</span> Wycieczki <span id="tripsCity">w Barcelonie</span></legend>
              <div class="row g-3" id="tripOptions">
                <div class="col-12"><p class="option-card">Sagrada Família i Park Güell · 249 zł za osobę</p></div>
                <div class="col-12"><p class="option-card">Rejs o zachodzie słońca · 199 zł za osobę</p></div>
                <div class="col-12"><p class="option-card">Warsztaty tapas w Dzielnicy Gotyckiej · 229 zł za osobę</p></div>
              </div>
            </fieldset>
          </section>

          <section class="form-section" aria-labelledby="res-guest">
            <h2 class="form-section__title" id="res-guest"><span class="form-section__step">5</span> Dane gościa</h2>
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label" for="resFirstName">Imię</label>
                <input class="form-control" type="text" id="resFirstName" required autocomplete="given-name">
                <div class="invalid-feedback">Podaj imię.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="resLastName">Nazwisko</label>
                <input class="form-control" type="text" id="resLastName" required autocomplete="family-name">
                <div class="invalid-feedback">Podaj nazwisko.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="resEmail">E-mail</label>
                <input class="form-control" type="email" id="resEmail" required autocomplete="email">
                <div class="invalid-feedback">Podaj poprawny adres e-mail.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="resPhone">Telefon</label>
                <input class="form-control" type="tel" id="resPhone" required autocomplete="tel" minlength="9">
                <div class="invalid-feedback">Podaj numer telefonu.</div>
              </div>
              <div class="col-12">
                <label class="form-label" for="resNotes">Uwagi do pobytu (opcjonalnie)</label>
                <textarea class="form-control" id="resNotes" rows="3"></textarea>
              </div>
            </div>
          </section>
        </div>

        <div class="col-lg-4">
          <section class="card summary-card" aria-labelledby="res-summary">
            <div class="card-body">
              <h2 class="summary-card__title" id="res-summary">Twój pobyt</h2>
              <p class="summary-card__hotel" id="resSumHotel">e-spania Barcelona</p>
              <p class="summary-card__note" id="resSumDates">Wybierz daty, aby zobaczyć cenę pobytu.</p>
              <ul class="summary-list" id="resSumLines"></ul>
              <p class="summary-total"><span>Razem</span><strong id="resSumTotal" aria-live="polite">0 zł</strong></p>
              <button class="btn btn-accent btn-lg-pill w-100" type="submit">Przejdź do płatności</button>
            </div>
          </section>
        </div>
      </div>
    </form>
  </main>

  <Fragment slot="po-stopce">
    <!-- ===================== POWIADOMIENIA (toast) ===================== -->
    <div class="toast-container position-fixed p-3 es-toast-container">
      <div class="toast es-toast" id="appToast" role="status" aria-live="polite" aria-atomic="true">
        <div class="es-toast__body">
          <p class="es-toast__title" id="appToastTitle"></p>
          <p class="es-toast__text" id="appToastText"></p>
        </div>
        <button type="button" class="icon-btn es-toast__close" data-bs-dismiss="toast" aria-label="Zamknij powiadomienie"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-close"/></svg></button>
      </div>
    </div>


  </Fragment>
</Layout>
