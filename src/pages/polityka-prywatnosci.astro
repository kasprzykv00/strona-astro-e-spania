---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
import { url, abs } from '../utils/url.js';
import { company, fullAddress } from '../data/company.js';

const description = 'Polityka prywatności e-spania: kto jest administratorem danych, w jakich celach je przetwarzamy, jakie prawa daje Ci RODO i jakich plików cookies używamy.';
const updated = { iso: '2026-11-13', text: '13 listopada 2026' };

const cookies = [
  { name: 'es-lang', type: 'Niezbędne (localStorage)', purpose: 'Zapamiętuje wybrany język strony (PL, EN, ES).', time: 'Do usunięcia przez użytkownika' },
  { name: 'es-cart, es-orders, es-bookings, es-profile', type: 'Niezbędne (localStorage)', purpose: 'Przechowują koszyk, zamówienia, rezerwacje i dane konta w wersji demonstracyjnej serwisu.', time: 'Do usunięcia przez użytkownika' },
  { name: 'es-intro', type: 'Funkcjonalne (sessionStorage)', purpose: 'Pomija animację powitalną przy kolejnych odsłonach.', time: 'Do zamknięcia karty' },
  { name: 'es-city', type: 'Funkcjonalne (localStorage)', purpose: 'Zapamiętuje ostatnio wybrany hotel (miasto).', time: 'Do usunięcia przez użytkownika' },
  { name: '_ga, _ga_*', type: 'Analityczne (opcjonalne)', purpose: 'Anonimowe statystyki odwiedzin — tylko po wyrażeniu zgody.', time: '13 miesięcy' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Polityka prywatności',
      description,
      url: abs('polityka-prywatnosci/'),
      inLanguage: 'pl',
      dateModified: updated.iso,
      publisher: { '@type': 'Organization', '@id': `${abs()}#e-spania`, name: company.brand, legalName: company.legalName },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: abs() },
        { '@type': 'ListItem', position: 2, name: 'Polityka prywatności', item: abs('polityka-prywatnosci/') },
      ],
    },
  ],
};
---
<Layout title="Polityka prywatności i cookies | e-spania" page="polityka" newsletter={false}>
  <Fragment slot="head">
    <meta name="description" content={description}>

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content="Polityka prywatności — e-spania">
    <meta property="og:description" content={description}>
    <meta property="og:url" content={abs('polityka-prywatnosci/')}>
    <meta property="og:image" content={abs('assets/images/og-image.jpg')}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Basen przed bielonym domem z kwitnącą bugenwillą">

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </Fragment>

  <nav class="post-crumbs" aria-label="breadcrumb">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-8 mx-auto">
          <ol class="breadcrumb blog-breadcrumb">
            <li class="breadcrumb-item"><a href={url()}>Strona główna</a></li>
            <li class="breadcrumb-item active" aria-current="page">Polityka prywatności</li>
          </ol>
        </div>
      </div>
    </div>
  </nav>

  <main id="main">
    <article class="legal" aria-labelledby="legal-title">
      <header class="post-header legal__header">
        <div class="container">
          <div class="row">
            <div class="col-12 col-lg-8 mx-auto">
              <h1 class="legal__title" id="legal-title">Polityka prywatności</h1>
              <p class="legal__updated">Ostatnia aktualizacja: <time datetime={updated.iso}>{updated.text}</time></p>
            </div>
          </div>
        </div>
      </header>

      <div class="container">
        <div class="row">
          <div class="col-12 col-lg-8 mx-auto legal__body">
          <p class="legal__lead">Szanujemy Twoją prywatność. Poniżej wyjaśniamy prostym językiem, jakie dane zbieramy w serwisie e-spania, po co to robimy i jakie masz prawa.</p>

          <section class="legal__section" aria-labelledby="legal-1">
            <h2 class="legal__heading" id="legal-1"><span class="legal__num">§ 1.</span> Administrator Danych Osobowych</h2>
            <p>Administratorem Twoich danych osobowych jest <strong>{company.legalName}</strong> z siedzibą pod adresem {fullAddress}, {company.address.country}, NIF {company.nif} (dalej: „Administrator”).</p>
            <p>W sprawach dotyczących ochrony danych możesz kontaktować się z nami:</p>
            <ul>
              <li>e-mailem: <a href={`mailto:${company.email}`}>{company.email}</a>,</li>
              <li>telefonicznie: <a href={company.phoneHref}>{company.phone}</a>,</li>
              <li>przez <a href={url('kontakt/')}>formularz kontaktowy</a>, wybierając dział „Obsługa klienta”.</li>
            </ul>
          </section>

          <section class="legal__section" aria-labelledby="legal-2">
            <h2 class="legal__heading" id="legal-2"><span class="legal__num">§ 2.</span> Cele i Podstawy Przetwarzania Danych</h2>
            <p>Przetwarzamy wyłącznie dane, które są potrzebne do konkretnego celu:</p>
            <ol>
              <li><strong>Rezerwacja pobytu i realizacja zamówień w sklepie</strong> — na podstawie umowy (art. 6 ust. 1 lit. b RODO).</li>
              <li><strong>Odpowiedź na wiadomość z formularza kontaktowego</strong> — na podstawie Twojej zgody (art. 6 ust. 1 lit. a RODO).</li>
              <li><strong>Wysyłka newslettera</strong> — na podstawie zgody, którą możesz wycofać w każdej chwili, klikając link w stopce wiadomości.</li>
              <li><strong>Rozliczenia podatkowe i księgowe</strong> — na podstawie obowiązku prawnego (art. 6 ust. 1 lit. c RODO).</li>
              <li><strong>Dochodzenie roszczeń i statystyki serwisu</strong> — na podstawie prawnie uzasadnionego interesu Administratora (art. 6 ust. 1 lit. f RODO).</li>
            </ol>
            <p>Dane przechowujemy tylko tak długo, jak wymaga tego cel lub przepisy — dane rozliczeniowe przez 5 lat, wiadomości z formularza przez 12 miesięcy od zakończenia korespondencji.</p>
          </section>

          <section class="legal__section" aria-labelledby="legal-3">
            <h2 class="legal__heading" id="legal-3"><span class="legal__num">§ 3.</span> Prawa Użytkownika (RODO)</h2>
            <p>W związku z przetwarzaniem danych przysługuje Ci prawo do:</p>
            <ul>
              <li>dostępu do swoich danych i otrzymania ich kopii,</li>
              <li>sprostowania (poprawienia) danych,</li>
              <li>usunięcia danych („prawo do bycia zapomnianym”),</li>
              <li>ograniczenia przetwarzania,</li>
              <li>przenoszenia danych do innego administratora,</li>
              <li>wniesienia sprzeciwu wobec przetwarzania,</li>
              <li>wycofania zgody w dowolnym momencie — bez wpływu na zgodność z prawem wcześniejszego przetwarzania.</li>
            </ul>
            <p>Masz też prawo wnieść skargę do organu nadzorczego — w Polsce jest nim Prezes Urzędu Ochrony Danych Osobowych, a w Hiszpanii Agencia Española de Protección de Datos.</p>
          </section>

          <section class="legal__section" aria-labelledby="legal-4">
            <h2 class="legal__heading" id="legal-4"><span class="legal__num">§ 4.</span> Polityka Plików Cookies</h2>
            <p>Serwis korzysta z plików cookies i pamięci przeglądarki (localStorage, sessionStorage), aby działał poprawnie i zapamiętywał Twoje ustawienia. Ustawienia cookies możesz zmienić w swojej przeglądarce w każdej chwili.</p>
            <div class="table-responsive legal__table-wrap">
              <table class="table legal-table">
                <caption>Rodzaje plików cookies i danych zapisywanych w przeglądarce</caption>
                <thead>
                  <tr>
                    <th scope="col">Nazwa</th>
                    <th scope="col">Rodzaj</th>
                    <th scope="col">Cel</th>
                    <th scope="col">Czas przechowywania</th>
                  </tr>
                </thead>
                <tbody>
                  {cookies.map((c) => (
                    <tr>
                      <th scope="row"><code>{c.name}</code></th>
                      <td>{c.type}</td>
                      <td>{c.purpose}</td>
                      <td>{c.time}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Toast slot="po-stopce" />
</Layout>
