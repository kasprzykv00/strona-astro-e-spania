---
import Layout from '../layouts/Layout.astro';
import Toast from '../components/Toast.astro';
import { url } from '../utils/url.js';
---
<Layout title="Kasa — dane i dostawa | Sklep e-spania" page="zamowienie">
  <Fragment slot="head">
    <meta name="description" content="Dokończ zamówienie w sklepie e-spania: dane do wysyłki, sposób dostawy i metoda płatności.">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content="Kasa — sklep e-spania">
    <meta property="og:description" content="Dokończ zamówienie w sklepie e-spania: dane do wysyłki, sposób dostawy i metoda płatności.">
    <meta property="og:url" content="https://kasprzykv00.github.io/strona-astro-e-spania/zamowienie/">
    <meta property="og:image" content="https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/sklep/og-sklep.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Złożone ręczniki w piaskowe i granatowe pasy">

    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "Kasa",
          "description": "Dokończ zamówienie w sklepie e-spania: dane do wysyłki, sposób dostawy i metoda płatności.",
          "url": "https://kasprzykv00.github.io/strona-astro-e-spania/zamowienie/",
          "inLanguage": "pl"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Strona główna",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Koszyk",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/koszyk/"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Kasa",
              "item": "https://kasprzykv00.github.io/strona-astro-e-spania/zamowienie/"
            }
          ]
        }
      ]
    }
    </script>
  </Fragment>

  <section class="page-header page-header--plain" aria-labelledby="page-title">
    <div class="container page-header__inner">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb blog-breadcrumb">
          <li class="breadcrumb-item"><a href={url()}>Strona główna</a></li>
          <li class="breadcrumb-item"><a href={url('koszyk/')}>Koszyk</a></li>
          <li class="breadcrumb-item active" aria-current="page">Kasa</li>
        </ol>
      </nav>
      <h1 class="page-header__title" id="page-title">Kasa</h1>
    </div>
  </section>

  <main id="main" class="container shop-layout">
    <form class="shop-form" id="checkoutForm" novalidate>
      <div class="row gx-lg-5 gy-5">
        <div class="col-lg-7">
          <div class="form-errors" id="checkoutErrors" role="alert" tabindex="-1" hidden>
            <h2 class="form-errors__title">Sprawdź formularz</h2>
            <ul></ul>
          </div>

          <section class="form-section" aria-labelledby="co-address">
            <h2 class="form-section__title" id="co-address">Dane i adres dostawy</h2>
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label" for="coFirstName">Imię</label>
                <input class="form-control" type="text" id="coFirstName" required autocomplete="given-name">
                <div class="invalid-feedback">Podaj imię.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="coLastName">Nazwisko</label>
                <input class="form-control" type="text" id="coLastName" required autocomplete="family-name">
                <div class="invalid-feedback">Podaj nazwisko.</div>
              </div>
              <div class="col-12">
                <label class="form-label" for="coStreet">Ulica i numer</label>
                <input class="form-control" type="text" id="coStreet" required autocomplete="address-line1">
                <div class="invalid-feedback">Podaj ulicę i numer.</div>
              </div>
              <div class="col-5">
                <label class="form-label" for="coPostal">Kod pocztowy</label>
                <input class="form-control" type="text" id="coPostal" required pattern="[0-9]{2}-[0-9]{3}" autocomplete="postal-code" inputmode="numeric">
                <div class="invalid-feedback">Wpisz kod w formacie 00-000.</div>
              </div>
              <div class="col-7">
                <label class="form-label" for="coCity">Miasto</label>
                <input class="form-control" type="text" id="coCity" required autocomplete="address-level2">
                <div class="invalid-feedback">Podaj miasto.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="coPhone">Telefon</label>
                <input class="form-control" type="tel" id="coPhone" required autocomplete="tel" minlength="9">
                <div class="invalid-feedback">Podaj numer telefonu.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="coEmail">E-mail</label>
                <input class="form-control" type="email" id="coEmail" required autocomplete="email">
                <div class="invalid-feedback">Podaj poprawny adres e-mail.</div>
              </div>
            </div>
          </section>

          <section class="form-section">
            <fieldset>
              <legend class="form-section__title">Metoda dostawy</legend>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="delivery" id="del-kurier" value="kurier" checked>
                  <label class="form-check-label" for="del-kurier"><span class="option-card__name">Kurier · 14,90 zł</span><span class="option-card__text">Dostawa w 1–2 dni robocze</span></label>
                </div>
              </div>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="delivery" id="del-paczkomat" value="paczkomat">
                  <label class="form-check-label" for="del-paczkomat"><span class="option-card__name">Paczkomat · 9,90 zł</span><span class="option-card__text">Odbiór w wybranym automacie</span></label>
                </div>
              </div>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="delivery" id="del-odbior" value="odbior">
                  <label class="form-check-label" for="del-odbior"><span class="option-card__name">Odbiór osobisty · 0 zł</span><span class="option-card__text">W recepcji wybranego hotelu</span></label>
                </div>
              </div>
            </fieldset>
          </section>

          <section class="form-section">
            <fieldset>
              <legend class="form-section__title">Metoda płatności</legend>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="payment" id="pay-blik" value="blik" checked>
                  <label class="form-check-label" for="pay-blik"><span class="option-card__name">BLIK</span><span class="option-card__text">Kod z aplikacji bankowej</span></label>
                </div>
              </div>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="payment" id="pay-karta" value="karta">
                  <label class="form-check-label" for="pay-karta"><span class="option-card__name">Karta płatnicza</span><span class="option-card__text">Visa, Mastercard</span></label>
                </div>
              </div>
              <div class="option-card option-card--compact">
                <div class="form-check option-card__check">
                  <input class="form-check-input" type="radio" name="payment" id="pay-przelew" value="przelew">
                  <label class="form-check-label" for="pay-przelew"><span class="option-card__name">Szybki przelew</span><span class="option-card__text">Wybór banku w następnym kroku</span></label>
                </div>
              </div>
            </fieldset>
          </section>

          <section class="form-section" aria-labelledby="co-final">
            <h2 class="form-section__title" id="co-final">Faktura i zgody</h2>
            <div class="form-check form-switch shop-check">
              <input class="form-check-input" type="checkbox" role="switch" id="wantInvoice">
              <label class="form-check-label" for="wantInvoice">Chcę otrzymać fakturę na firmę</label>
            </div>
            <div class="row g-3 invoice-fields" id="invoiceFields" hidden>
              <div class="col-sm-6">
                <label class="form-label" for="coCompany">Nazwa firmy</label>
                <input class="form-control" type="text" id="coCompany" autocomplete="organization">
                <div class="invalid-feedback">Podaj nazwę firmy.</div>
              </div>
              <div class="col-sm-6">
                <label class="form-label" for="coNip">NIP</label>
                <input class="form-control" type="text" id="coNip" pattern="[0-9]{10}" inputmode="numeric">
                <div class="invalid-feedback">NIP ma 10 cyfr, bez kresek.</div>
              </div>
            </div>
            <div class="form-check shop-check">
              <input class="form-check-input" type="checkbox" id="acceptTerms" required>
              <label class="form-check-label" for="acceptTerms">Akceptuję regulamin sklepu</label>
              <button class="btn-inline" type="button" data-bs-toggle="modal" data-bs-target="#termsModal">Przeczytaj regulamin</button>
              <div class="invalid-feedback">Zaakceptuj regulamin sklepu.</div>
            </div>
            <div class="form-check shop-check">
              <input class="form-check-input" type="checkbox" id="acceptPrivacy" required>
              <label class="form-check-label" for="acceptPrivacy">Zapoznałem się z zasadami przetwarzania danych</label>
              <div class="invalid-feedback">Potwierdź zasady przetwarzania danych.</div>
            </div>
          </section>
        </div>

        <div class="col-lg-5">
          <section class="card summary-card" aria-labelledby="co-summary">
            <div class="card-body">
              <h2 class="summary-card__title" id="co-summary">Twoje zamówienie</h2>
              <p class="summary-card__note" id="checkoutEmpty" hidden>Koszyk jest pusty. <a href={url('sklep/')}>Wróć do sklepu</a></p>
              <ul class="summary-list" id="checkoutItems">
                <li class="summary-item"><span>Ręcznik plażowy Costa<small>Niebieski · 1 szt.</small></span><span>149 zł</span></li>
                <li class="summary-item"><span>Komplet ceramiki Alba<small>Na 1 osobę · 1 szt.</small></span><span>289 zł</span></li>
              </ul>
              <ul class="summary-list summary-list--costs">
                <li class="summary-item"><span>Produkty</span><span id="checkoutSubtotal">438 zł</span></li>
                <li class="summary-item summary-item--discount" id="checkoutDiscountRow" hidden><span>Rabat</span><span id="checkoutDiscount"></span></li>
                <li class="summary-item"><span id="checkoutShippingLabel">Dostawa: Kurier</span><span id="checkoutShipping">14,90 zł</span></li>
              </ul>
              <p class="summary-total"><span>Razem</span><strong id="checkoutTotal">452,90 zł</strong></p>
              <button class="btn btn-accent btn-lg-pill w-100" id="checkoutPay" type="submit">Kupuję i płacę</button>
              <a class="summary-card__back" href={url('koszyk/')}>Wróć do koszyka</a>
            </div>
          </section>
        </div>
      </div>
    </form>
  </main>

  <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsTitle">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content shop-modal">
        <div class="modal-header">
          <h2 class="modal-title shop-modal__title" id="termsTitle">Regulamin sklepu</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
        </div>
        <div class="modal-body">
          <p>Sklep e-spania prowadzi sprzedaż produktów hotelowych i voucherów na terenie Polski. Zamówienia realizujemy w ciągu 1–2 dni roboczych od zaksięgowania płatności.</p>
          <p>Produkt można zwrócić w ciągu 14 dni od odbioru, bez podawania przyczyny. Voucher jest ważny 24 miesiące od daty zakupu.</p>
          <p>Pełny regulamin udostępnimy na osobnej podstronie.</p>
        </div>
      </div>
    </div>
  </div>

  <Toast slot="po-stopce" />
</Layout>
