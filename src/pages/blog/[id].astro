---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toast from '../../components/Toast.astro';
import { url, abs } from '../../utils/url.js';
import { longDate, isoDate } from '../../utils/format.js';
import { authors } from '../../data/authors.js';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const author = authors[d.author];
const postUrl = `blog/${post.id}/`;
const cover = d.cover ?? { src: d.image, alt: d.imageAlt };
const coverSize = d.cover?.large ? { width: 1600, height: 900 } : { width: 800, height: 600 };
const coverSrcset = d.cover?.large ? `${url(d.cover.src)} 900w, ${url(d.cover.large)} 1600w` : undefined;
const description = d.description ?? d.excerpt;
const commentCount = d.comments.reduce((sum, c) => sum + 1 + c.replies.length, 0);
let commentNo = 0;
const nextCommentId = () => `comment-${++commentNo}-author`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${abs(postUrl)}#artykul`,
      headline: d.title,
      description,
      image: [abs(d.cover?.large ?? cover.src), ...(d.ogImage ? [abs(d.ogImage)] : [])],
      datePublished: isoDate(d.date),
      author: { '@type': 'Person', name: author.name, url: `${abs(postUrl)}#autor` },
      publisher: { '@type': 'Organization', name: 'e-spania', logo: { '@type': 'ImageObject', url: abs('assets/logo/logo-dark.png') } },
      mainEntityOfPage: { '@type': 'WebPage', '@id': abs(postUrl) },
      isPartOf: { '@type': 'Blog', '@id': `${abs('blog/')}#blog`, name: 'Blog e-spania' },
      articleSection: d.category,
      keywords: d.tags,
      inLanguage: 'pl',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: abs() },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: abs('blog/') },
        { '@type': 'ListItem', position: 3, name: d.title, item: abs(postUrl) },
      ],
    },
  ],
};
---
<Layout title={`${d.seoTitle ?? d.shortTitle} | e-spania`}>
  <Fragment slot="head">
    <meta name="description" content={description}>
    <meta name="author" content={author.name}>
    <meta property="og:type" content="article">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="e-spania">
    <meta property="og:title" content={d.title}>
    <meta property="og:description" content={d.excerpt}>
    <meta property="og:url" content={abs(postUrl)}>
    <meta property="og:image" content={abs(d.ogImage ?? d.image)}>
    <meta property="og:image:alt" content={d.imageAlt}>
    <meta property="article:published_time" content={isoDate(d.date)}>
    <meta property="article:author" content={author.name}>
    <meta property="article:section" content={d.category}>
    {d.tags.map((tag) => <meta property="article:tag" content={tag}>)}
    <link rel="preload" as="image" href={url(cover.src)} imagesrcset={coverSrcset} imagesizes={coverSrcset ? '(min-width: 992px) 46rem, 100vw' : undefined}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </Fragment>

  <main id="main">
    <nav class="post-crumbs" aria-label="breadcrumb">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 col-xl-8 col-xxl-7">
            <ol class="breadcrumb blog-breadcrumb">
              <li class="breadcrumb-item"><a href={url()}>Strona główna</a></li>
              <li class="breadcrumb-item"><a href={url('blog/')}>Blog</a></li>
              <li class="breadcrumb-item active" aria-current="page">{d.shortTitle}</li>
            </ol>
          </div>
        </div>
      </div>
    </nav>

    <article class="post" id="artykul">
      <header class="post-header">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8 col-xxl-7">
              <h1 class="post-header__title">{d.title}</h1>
              <ul class="post-meta-bar">
                <li><span class="post-meta-bar__label">Data publikacji</span><time class="post-meta-bar__value" datetime={isoDate(d.date)}>{longDate(d.date)}</time></li>
                <li><span class="post-meta-bar__label">Autor</span><a class="post-meta-bar__value" href="#autor">{author.name}</a></li>
                {d.readingTime && <li><span class="post-meta-bar__label">Czas czytania</span><span class="post-meta-bar__value">{d.readingTime}</span></li>}
                <li><span class="post-meta-bar__label">Kategoria</span><a class="post-meta-bar__value" href={url('blog/#wpisy')}>{d.category}</a></li>
              </ul>
            </div>
          </div>
        </div>
      </header>

      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-10 col-xl-8 col-xxl-7">
            <figure class="post-cover">
              <img src={url(cover.src)} srcset={coverSrcset} sizes={coverSrcset ? '(min-width: 992px) 46rem, 100vw' : undefined} width={coverSize.width} height={coverSize.height} fetchpriority="high" alt={cover.alt}>
              {d.cover?.caption && <figcaption class="post-cover__caption">{d.cover.caption}</figcaption>}
            </figure>

            <div class="post-content">
              <Content />
            </div>

            <footer class="post-footer">
              {d.tags.length > 0 && (
                <div>
                  <h2 class="post-footer__title" id="tags-title">Tagi</h2>
                  <ul class="tag-list" aria-labelledby="tags-title">
                    {d.tags.map((tag) => <li><a class="badge tag-badge" href={url('blog/#wpisy')}>{tag}</a></li>)}
                  </ul>
                </div>
              )}

              <div>
                <h2 class="post-footer__title" id="share-title">Udostępnij artykuł</h2>
                <ul class="share-list" aria-labelledby="share-title">
                  <li><a class="btn share-btn" href="https://www.facebook.com/sharer/sharer.php" data-share="https://www.facebook.com/sharer/sharer.php?u={url}" target="_blank" rel="noopener">Facebook<span class="visually-hidden"> (otwiera się w nowej karcie)</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-external"/></svg></a></li>
                  <li><a class="btn share-btn" href="https://twitter.com/intent/tweet" data-share="https://twitter.com/intent/tweet?url={url}&amp;text={title}" target="_blank" rel="noopener">X<span class="visually-hidden"> (dawniej Twitter, otwiera się w nowej karcie)</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-external"/></svg></a></li>
                  <li><a class="btn share-btn" href="https://www.linkedin.com/sharing/share-offsite/" data-share="https://www.linkedin.com/sharing/share-offsite/?url={url}" target="_blank" rel="noopener">LinkedIn<span class="visually-hidden"> (otwiera się w nowej karcie)</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-external"/></svg></a></li>
                  <li><button class="btn share-btn" type="button" data-copy-link>Kopiuj link<svg class="icon icon--sm" aria-hidden="true"><use href="#i-link"/></svg></button></li>
                </ul>
              </div>

              <section class="author-box" id="autor" aria-labelledby="author-name">
                <span class="author-box__avatar" aria-hidden="true">{author.initials}</span>
                <div>
                  <p class="author-box__label">O autorze</p>
                  <h2 class="author-box__name" id="author-name">{author.name}</h2>
                  <p class="author-box__bio">{author.bio}</p>
                </div>
              </section>
            </footer>
          </div>
        </div>
      </div>
    </article>

    <div class="container post-after">
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8 col-xxl-7">

          <nav class="post-nav" aria-label="Sąsiednie wpisy">
            <div class="row gy-3 gx-4">
              <div class="col-md-6">
                {prev && (
                  <a class="post-nav__link" href={url(`blog/${prev.id}/`)} rel="prev">
                    <span class="post-nav__dir"><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow-left"/></svg>Poprzedni wpis</span>
                    <span class="post-nav__title">{prev.data.title}</span>
                  </a>
                )}
              </div>
              <div class="col-md-6">
                {next && (
                  <a class="post-nav__link post-nav__link--next" href={url(`blog/${next.id}/`)} rel="next">
                    <span class="post-nav__dir">Następny wpis<svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></span>
                    <span class="post-nav__title">{next.data.title}</span>
                  </a>
                )}
              </div>
            </div>
          </nav>

          <section class="comments" id="komentarze" aria-labelledby="comments-title">
            <h2 class="comments__title" id="comments-title">Komentarze <span class="comments__count">({commentCount})</span></h2>

            {d.comments.length > 0 && (
              <ol class="comment-list">
                {d.comments.map((comment) => {
                  const id = nextCommentId();
                  return (
                    <li>
                      <article class="comment" aria-labelledby={id}>
                        <span class="comment__avatar" aria-hidden="true">{comment.author.charAt(0)}</span>
                        <div>
                          <header class="comment__header">
                            <span class="comment__author" id={id}>{comment.author}</span>
                            <time class="comment__date" datetime={isoDate(comment.date)}>{longDate(comment.date)}</time>
                          </header>
                          <p class="comment__text">{comment.text}</p>
                        </div>
                      </article>
                      {comment.replies.length > 0 && (
                        <ol class="comment-list comment-list--replies">
                          {comment.replies.map((reply) => {
                            const replyId = nextCommentId();
                            const name = reply.byPostAuthor ? author.name : reply.author ?? 'Gość';
                            return (
                              <li>
                                <article class="comment" aria-labelledby={replyId}>
                                  <span class={`comment__avatar${reply.byPostAuthor ? ' comment__avatar--author' : ''}`} aria-hidden="true">{reply.byPostAuthor ? author.initials : name.charAt(0)}</span>
                                  <div>
                                    <header class="comment__header">
                                      <span class="comment__author" id={replyId}>{name}</span>
                                      {reply.byPostAuthor && <span class="comment__role">Autor</span>}
                                      <time class="comment__date" datetime={isoDate(reply.date)}>{longDate(reply.date)}</time>
                                    </header>
                                    <p class="comment__text">{reply.text}</p>
                                  </div>
                                </article>
                              </li>
                            );
                          })}
                        </ol>
                      )}
                    </li>
                  );
                })}
              </ol>
            )}

            <form class="comment-form" novalidate data-demo-form data-demo-title="Dziękujemy za komentarz" data-demo-text="Pojawi się na stronie po krótkiej moderacji.">
              <h3 class="comment-form__title">Dodaj komentarz</h3>
              <p class="comment-form__intro">Adres e-mail nie zostanie opublikowany. Pola oznaczone <span aria-hidden="true">*</span><span class="visually-hidden">gwiazdką</span> są wymagane.</p>
              <div class="row gy-3">
                <div class="col-md-6">
                  <label class="form-label" for="commentName">Imię <span aria-hidden="true">*</span></label>
                  <input class="form-control" type="text" id="commentName" name="name" autocomplete="name" required aria-describedby="commentNameError">
                  <p class="invalid-feedback" id="commentNameError">Podaj swoje imię.</p>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="commentEmail">E-mail <span aria-hidden="true">*</span></label>
                  <input class="form-control" type="email" id="commentEmail" name="email" autocomplete="email" required aria-describedby="commentEmailError">
                  <p class="invalid-feedback" id="commentEmailError">Podaj poprawny adres e-mail.</p>
                </div>
                <div class="col-12">
                  <label class="form-label" for="commentText">Komentarz <span aria-hidden="true">*</span></label>
                  <textarea class="form-control" id="commentText" name="comment" rows="5" required minlength="10" aria-describedby="commentTextError"></textarea>
                  <p class="invalid-feedback" id="commentTextError">Komentarz powinien mieć co najmniej 10 znaków.</p>
                </div>
                <div class="col-12">
                  <button class="btn btn-accent" type="submit">Opublikuj komentarz</button>
                </div>
              </div>
            </form>
          </section>

        </div>
      </div>
    </div>
  </main>

  <Toast slot="po-stopce" />
</Layout>
