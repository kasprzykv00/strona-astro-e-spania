---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../utils/url.js';

const {
  title = 'e-spania — hotele w Barcelonie, Maladze i Madrycie | Rezerwacja',
  description = 'e-spania to hotele w Barcelonie, Maladze i Madrycie: jasne pokoje i spokojny, hiszpański rytm dnia. Wybierz miasto, sprawdź termin i wybierz pokój.',
  page = 'start',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#2B2929">

  <!-- Open Graph: pełne adresy strony na GitHub Pages (https://kasprzykv00.github.io/strona-astro-e-spania/). -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://kasprzykv00.github.io/strona-astro-e-spania/">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content="e-spania">
  <meta property="og:title" content="e-spania — hotele w Barcelonie, Maladze i Madrycie">
  <meta property="og:description" content="Jasne pokoje i spokojny, hiszpański rytm dnia w trzech miastach. Wybierz hotel, sprawdź dostępność i zaplanuj pobyt.">
  <meta property="og:image" content="https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Basen przed bielonym domem z kwitnącą bugenwillą">

  <link rel="icon" type="image/png" href={url('assets/logo/logo-dark.png')}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" integrity="sha384-nWN3KqaaVcbEsCjLSV+2jMjh62Iny/+mN3srM8TZeM8N6aj7eDl5wwYggjAJ4/sJ" crossorigin="anonymous">
  <link rel="stylesheet" href={url('css/styles.css')}>

  <!-- Duże zdjęcie z góry strony ładujemy z wyprzedzeniem tylko na stronie głównej -->
  {page === 'start' && (
    <>
      <link rel="preload" as="image" href={url('assets/images/hero-mobile.webp')} media="(max-width: 767.98px)">
      <link rel="preload" as="image" href={url('assets/images/hero-1280.webp')} imagesrcset={`${url('assets/images/hero-1280.webp')} 1280w, ${url('assets/images/hero-1920.webp')} 1920w`} imagesizes="100vw" media="(min-width: 768px)">
    </>
  )}

  <script is:inline>
    document.documentElement.classList.add('js');
    // Wybrany język EN/ES: strona czeka ukryta, aż main.js podmieni teksty (najwyżej 3 s)
    try {
      const lang = localStorage.getItem('es-lang');
      if (lang === 'en' || lang === 'es') {
        document.documentElement.lang = lang;
        document.documentElement.classList.add('i18n-pending');
        setTimeout(() => document.documentElement.classList.remove('i18n-pending'), 3000);
      }
    } catch (e) { /* bez localStorage strona zostaje po polsku */ }
    try {
      if (sessionStorage.getItem('es-intro')) document.documentElement.classList.add('no-intro');
      sessionStorage.setItem('es-intro', '1');
    } catch (e) { /* bez sessionStorage kurtyna pokaże się za każdym razem */ }
    // Zapamiętane miasto inne niż domyślna Barcelona: teksty zależne od miasta czekają
    // ukryte, aż main.js je podmieni (bez mignięcia treści barcelońskiej)
    try {
      const city = localStorage.getItem('es-city');
      if (city && city !== 'barcelona') document.documentElement.classList.add('city-pending');
    } catch (e) { /* bez localStorage zawsze startuje Barcelona */ }
  </script>

  <!-- Dane strukturalne: marka i trzy hotele -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania",
        "name": "e-spania",
        "description": "Hotele w Barcelonie, Maladze i Madrycie z jasnymi pokojami i spokojnym, hiszpańskim charakterem.",
        "logo": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/logo/logo-dark.png",
        "url": "https://kasprzykv00.github.io/strona-astro-e-spania/"
      },
      {
        "@type": "Hotel",
        "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-barcelona",
        "name": "e-spania Barcelona",
        "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
        "address": { "@type": "PostalAddress", "streetAddress": "Passeig de la Llum 12", "postalCode": "08003", "addressLocality": "Barcelona", "addressCountry": "ES" },
        "telephone": "+34 900 000 123",
        "email": "kontakt@e-spania.example",
        "priceRange": "420–980 zł",
        "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
        "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
        "availableLanguage": ["pl", "en", "es"]
      },
      {
        "@type": "Hotel",
        "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-malaga",
        "name": "e-spania Malaga",
        "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
        "address": { "@type": "PostalAddress", "streetAddress": "Paseo del Sol 18", "postalCode": "29016", "addressLocality": "Málaga", "addressCountry": "ES" },
        "telephone": "+34 900 000 123",
        "email": "kontakt@e-spania.example",
        "priceRange": "420–980 zł",
        "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
        "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
        "availableLanguage": ["pl", "en", "es"]
      },
      {
        "@type": "Hotel",
        "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#hotel-madryt",
        "name": "e-spania Madryt",
        "image": "https://kasprzykv00.github.io/strona-astro-e-spania/assets/images/og-image.jpg",
        "address": { "@type": "PostalAddress", "streetAddress": "Calle de la Luz 21", "postalCode": "28014", "addressLocality": "Madrid", "addressCountry": "ES" },
        "telephone": "+34 900 000 123",
        "email": "kontakt@e-spania.example",
        "priceRange": "420–980 zł",
        "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
        "parentOrganization": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" },
        "availableLanguage": ["pl", "en", "es"]
      },
      {
        "@type": "WebSite",
        "name": "e-spania",
        "url": "https://kasprzykv00.github.io/strona-astro-e-spania/",
        "inLanguage": ["pl", "en", "es"],
        "about": { "@id": "https://kasprzykv00.github.io/strona-astro-e-spania/#e-spania" }
      }
    ]
  }
  </script>
</head>
<body data-page={page}>
  <a class="skip-link" href="#main">Przejdź do treści</a>

  <!-- Kurtyna przy pierwszym wejściu na stronę (animacja w CSS, raz na sesję) -->
  <div class="intro" aria-hidden="true">
    <img class="intro__logo" src={url('assets/logo/logo-light.png')} alt="e-spania" width="479" height="270">
  </div>

  <!-- Ikony SVG używane na stronie (rysunki w stylu Lucide, licencja ISC) -->
  <svg xmlns="http://www.w3.org/2000/svg" class="d-none" aria-hidden="true">
    <symbol id="i-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
    <symbol id="i-area" viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></symbol>
    <symbol id="i-bed" viewBox="0 0 24 24"><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4M12 4v6M2 18h20"/></symbol>
    <symbol id="i-view" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="i-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
    <symbol id="i-arrow-left" viewBox="0 0 24 24"><path d="M19 12H5M11 18l-6-6 6-6"/></symbol>
    <symbol id="i-arrow-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></symbol>
    <symbol id="i-pause" viewBox="0 0 24 24"><path d="M9 5v14M15 5v14"/></symbol>
    <symbol id="i-play" viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 8h18M3 16h18"/></symbol>
    <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></symbol>
  </svg>

  <Header />

  <main id="main">
    <slot />
  </main>

  <Footer />

  <!-- Miejsce na panele/okienka danej strony (np. wybór pokoju, galeria) -->
  <slot name="po-stopce" />

  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous" defer></script>
  <script is:inline src={url('js/i18n-en.js')} defer></script>
  <script is:inline src={url('js/i18n-es.js')} defer></script>
  <script is:inline src={url('js/main.js')} defer></script>
  <script is:inline src={url('js/shop-data.js')} defer></script>
  <script is:inline src={url('js/shop.js')} defer></script>
</body>
</html>
