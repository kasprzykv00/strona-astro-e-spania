---
import { url } from '../utils/url.js';
import { longDate, isoDate } from '../utils/format.js';
import { authors } from '../data/authors.js';

const { post, lazy = true } = Astro.props;
const { title, shortTitle, excerpt, category, date, author, image, imageAlt } = post.data;
const href = url(`blog/${post.id}/`);
---
<article class="card post-card" data-reveal>
  <figure class="post-card__media media-frame">
    <img src={url(image)} width="800" height="600" loading={lazy ? 'lazy' : undefined} decoding="async" alt={imageAlt}>
  </figure>
  <div class="card-body post-card__body">
    <div class="post-meta">
      <span class="badge post-badge">{category}</span>
      <time datetime={isoDate(date)}>{longDate(date)}</time>
      <span class="post-meta__author">{authors[author].name}</span>
    </div>
    <h3 class="card-title post-card__title"><a href={href}>{title}</a></h3>
    <p class="card-text post-card__lead">{excerpt}</p>
    <a class="btn link-arrow" href={href}>Czytaj dalej<span class="visually-hidden">: {shortTitle}</span><svg class="icon icon--sm" aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>
</article>
